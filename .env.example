# Copy to apps/api/.env. Development values are never suitable for production.
NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
PGLITE_DIR=./.data/pglite
STORAGE_DIR=./storage
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
OTP_DEV_ECHO=true
# DATABASE_URL=postgresql://torbat:change-me@127.0.0.1:5432/torbat
# SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# FILE_SIGNING_SECRET=replace-with-a-different-random-secret
# COOKIE_SECURE=true
# No external AI provider is connected in this release.
